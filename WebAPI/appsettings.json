{
  "ConnectionStrings": {
    "School": "Data Source=school.db;Foreign Keys=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{#if EventId.Name = 'RequestStarted'}\n================================================================================\n[{@t:yyyy-MM-dd HH:mm:ss} {@l:u3}] ▶ {@m}\n--------------------------------------------------------------------------------\n{#else}[{@t:HH:mm:ss} {@l:u3}] {@m}\n{#end}{@x}"
          }
        }
      }
    ]
  },
  "Database": {
    "EnableSensitiveDataLogging": true
  },
  "ExternalServices": {
    "TimeoutSeconds": 10,
    "JsonPlaceholder": {
      "BaseUrl": "https://jsonplaceholder.typicode.com/"
    }
  },
  "AllowedHosts": "*"
}
